{
  "name": "dsh-olivia-bridge",
  "version": "0.2.1",
  "description": "BSide: Olivia Lin bridge — serves the game client's /toy/letter/* contract locally and answers each letter through a DSH agent session.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "tools/install-desktop.ps1",
    "tools/patch-feapp.ps1",
    "tools/verify-patches.ps1",
    "tools/preset-persona.txt",
    "tools/inject.js",
    "tools/diagnose.mjs",
    "tools/decode-probes.mjs",
    "tools/dump-session.mjs",
    "tools/dump-session-full.mjs",
    "tools/verify.mjs"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "olivia-lin",
    "bside"
  ],
  "license": "MIT",
  "author": "MacilyDots <maicly@foxmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MacilyDots/dsh-olivia-bridge.git"
  },
  "homepage": "https://github.com/MacilyDots/dsh-olivia-bridge#readme",
  "bugs": {
    "url": "https://github.com/MacilyDots/dsh-olivia-bridge/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
